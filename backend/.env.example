# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/weekly_report_db?schema=public"

# JWT Secret for Authentication
JWT_SECRET="weekly_report_super_secret_jwt_key_2026_modern"
JWT_EXPIRES_IN="7d"

# Server Port
PORT=4000

# CORS Allowed Origin (Frontend URL)
FRONTEND_URL="http://localhost:3000"

# Optional AI API Key (Gemini or OpenAI API key if using cloud AI)
AI_API_KEY=""
